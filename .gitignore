# Dependencies
/node_modules

# Build output
/dist
/build
*.tsbuildinfo

# Test output
/coverage
/.nyc_output

# Environment files (local overrides stay untracked)
.env
.env.*.local
.env.local
.local.env
*.local.env

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
lerna-debug.log*

# Runtime data and diagnostic reports
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Temporary files
.temp
.tmp

# Claude Code: personal settings and notes stay local, .claude/settings.json is shared
.claude/settings.local.json
CLAUDE.local.md

# OS files
.DS_Store

# IDEs and editors (.zed/settings.json is tracked)
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
